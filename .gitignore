# ===========================
# Sakhi Project — Root .gitignore
# ===========================

# Environment secrets — NEVER commit these
.env
.env.local
.env.*.local

# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.pdb
venv/
.venv/
*.egg-info/
dist/
build/
.eggs/

# Node / Expo
node_modules/
.expo/
dist/
web-build/
expo-env.d.ts
.metro-health-check*

# Native mobile build artifacts
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision
/ios/
/android/
.kotlin/

# macOS
.DS_Store
*.pem

# IDE
.vscode/
.idea/
*.swp
*.swo

# Logs
npm-debug.*
yarn-debug.*
yarn-error.*
*.log

# TypeScript
*.tsbuildinfo
